            "value": "ca9e483f7f4043e89736bce810d40b83"
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "_",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "_",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [_ = Int64.Type], {{0}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Shipments",
            "expression": [
              "SUM ( Fact_VolumeSpend[Volume] )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Shipment volume",
            "formatString": "#,0"
          },
          {
            "name": "Rankable Shipments",
            "expression": [
              "CALCULATE (",
              "    [Total Shipments],",
              "    KEEPFILTERS ( Fact_VolumeSpend[IncludeInRanking] = \"Yes\" ),",
              "    KEEPFILTERS ( Fact_VolumeSpend[HasVolume] = \"Yes\" )",
              ")"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Shipment volume",
            "formatString": "#,0"
          },
          {
            "name": "YTD Shipments",
            "expression": [
              "VAR CurrentYear = MAX ( Dim_Date[Year] )",
              "VAR CurrentMonth = MAX ( Dim_Date[MonthNumber] )",
              "RETURN",
              "    CALCULATE (",
              "        [Total Shipments],",
              "        REMOVEFILTERS ( Dim_Date ),",
              "        Dim_Date[Year] = CurrentYear,",
              "        Dim_Date[MonthNumber] <= CurrentMonth",
              "    )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Shipment volume",
            "formatString": "#,0"
          },
          {
            "name": "Shipments PY",
            "expression": [
              "VAR PriorKeys =",
              "    SELECTCOLUMNS ( VALUES ( Dim_Date[MonthKey] ), \"@Key\", Dim_Date[MonthKey] - 100 )",
              "RETURN",
              "    CALCULATE (",
              "        [Total Shipments],",
              "        REMOVEFILTERS ( Dim_Date ),",
              "        TREATAS ( PriorKeys, Dim_Date[MonthKey] )",
              "    )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Shipment volume",
            "formatString": "#,0"
          },
          {
            "name": "Shipments YoY %",
            "expression": [
              "VAR Current = [Total Shipments]",
              "VAR Prior = [Shipments PY]",
              "RETURN",
              "    DIVIDE ( Current - Prior, Prior )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Shipment volume",
            "formatString": "0.0%"
          },
          {
            "name": "Shipments LY (Source)",
            "expression": [
              "SUM ( Fact_VolumeSpend[VolumeLY] )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Spend",
            "formatString": "#,0"
          },
          {
            "name": "Total Net Spend",
            "expression": [
              "SUM ( Fact_VolumeSpend[NetSpend] )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Spend",
            "formatString": "\\$#,0"
          },
          {
            "name": "Total Gross Spend",
            "expression": [
              "SUM ( Fact_VolumeSpend[GrossSpend] )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Spend",
            "formatString": "\\$#,0"
          },
          {
            "name": "Total Incentive",
            "expression": [
              "SUM ( Fact_VolumeSpend[Incentive] )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Spend",
            "formatString": "\\$#,0"
          },
          {
            "name": "Incentive %",
            "expression": [
              "DIVIDE ( [Total Incentive], [Total Gross Spend] )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Spend",
            "formatString": "0.0%"
          },
          {
            "name": "YTD Net Spend",
            "expression": [
              "VAR CurrentYear = MAX ( Dim_Date[Year] )",
              "VAR CurrentMonth = MAX ( Dim_Date[MonthNumber] )",
              "RETURN",
              "    CALCULATE (",
              "        [Total Net Spend],",
              "        REMOVEFILTERS ( Dim_Date ),",
              "        Dim_Date[Year] = CurrentYear,",
              "        Dim_Date[MonthNumber] <= CurrentMonth",
              "    )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Spend",
            "formatString": "\\$#,0"
          },
          {
            "name": "Net Spend PY",
            "expression": [
              "VAR PriorKeys =",
              "    SELECTCOLUMNS ( VALUES ( Dim_Date[MonthKey] ), \"@Key\", Dim_Date[MonthKey] - 100 )",
              "RETURN",
              "    CALCULATE (",
              "        [Total Net Spend],",
              "        REMOVEFILTERS ( Dim_Date ),",
              "        TREATAS ( PriorKeys, Dim_Date[MonthKey] )",
              "    )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Spend",
            "formatString": "\\$#,0"
          },
          {
            "name": "Net Spend YoY %",
            "expression": [
              "DIVIDE ( [Total Net Spend] - [Net Spend PY], [Net Spend PY] )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Cost efficiency",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Net Spend per Shipment",
            "expression": [
              "DIVIDE (",
              "    CALCULATE (",
              "        [Total Net Spend],",
              "        KEEPFILTERS ( Fact_VolumeSpend[IncludeInRanking] = \"Yes\" ),",
              "        KEEPFILTERS ( Fact_VolumeSpend[HasVolume] = \"Yes\" )",
              "    ),",
              "    [Rankable Shipments]",
              ")"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Cost efficiency",
            "formatString": "\\$#,0.00"
          },
          {
            "name": "Total Billed Weight",
            "expression": [
              "CALCULATE (",
              "    SUM ( Fact_VolumeSpend[BilledWeightLbs] ),",
              "    KEEPFILTERS ( Fact_VolumeSpend[IncludeInRanking] = \"Yes\" ),",
              "    KEEPFILTERS ( Fact_VolumeSpend[HasVolume] = \"Yes\" )",
              ")"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Cost efficiency",
            "formatString": "#,0"
          },
          {
            "name": "Avg Billed Weight per Shipment",
            "expression": [
              "DIVIDE ( [Total Billed Weight], [Rankable Shipments] )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Cost efficiency",
            "formatString": "#,0.0"
          },
          {
            "name": "Avg Net Spend per Billed Lb",
            "expression": [
              "DIVIDE (",
              "    CALCULATE (",
              "        [Total Net Spend],",
              "        KEEPFILTERS ( Fact_VolumeSpend[IncludeInRanking] = \"Yes\" ),",
              "        KEEPFILTERS ( Fact_VolumeSpend[HasVolume] = \"Yes\" )",
              "    ),",
              "    [Total Billed Weight]",
              ")"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Cost efficiency",
            "formatString": "\\$#,0.000"
          },
          {
            "name": "Weight-Adjusted Cost Premium",
            "expression": [
              "VAR BlendedRatePerLb =",
              "    CALCULATE (",
              "        [Avg Net Spend per Billed Lb],",
              "        REMOVEFILTERS ( Dim_Service ),",
              "        VALUES ( Dim_Date[MonthKey] )",
              "    )",
              "VAR ExpectedSpend = [Total Billed Weight] * BlendedRatePerLb",
              "RETURN",
              "    DIVIDE ( [Total Net Spend] - ExpectedSpend, ExpectedSpend )"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Mix",
            "formatString": "0.0%"
          },
          {
            "name": "Service Volume Mix %",
            "expression": [
              "DIVIDE (",
              "    [Rankable Shipments],",
              "    CALCULATE ( [Rankable Shipments], REMOVEFILTERS ( Dim_Service ) )",
              ")"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Mix",
            "formatString": "0.0%"
          },
          {
            "name": "Service Spend Mix %",
            "expression": [
              "DIVIDE (",
              "    [Total Net Spend],",
              "    CALCULATE ( [Total Net Spend], REMOVEFILTERS ( Dim_Service ) )",
              ")"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Mix",
            "formatString": "0.0%"
          },
          {
            "name": "Account Volume Mix %",
            "expression": [
              "DIVIDE (",
              "    [Rankable Shipments],",
              "    CALCULATE ( [Rankable Shipments], REMOVEFILTERS ( Dim_Account ) )",
              ")"
            ],
            "displayFolder": "1 Volume, Spend and Cost\\Mix",
            "formatString": "0.0%"
          },
          {
            "name": "Packages Measured",
            "expression": [
              "SUM ( Fact_TimeInTransit[PackagesMeasured] )"
            ],
            "displayFolder": "2 Reliability",
            "formatString": "#,0"
          },
          {
            "name": "Total Late",
            "expression": [
              "SUM ( Fact_TimeInTransit[TotalLate] )"
            ],
            "displayFolder": "2 Reliability",
            "formatString": "#,0"
          },
          {
            "name": "Late by Day",
            "expression": [
              "SUM ( Fact_TimeInTransit[LateByDay] )"
            ],
            "displayFolder": "2 Reliability",
            "formatString": "#,0"
          },
          {
            "name": "Late by Time",
            "expression": [
              "SUM ( Fact_TimeInTransit[LateByTime] )"
            ],
            "displayFolder": "2 Reliability",
            "formatString": "#,0"
          },
          {
            "name": "On-Time Packages",
            "expression": [
              "SUM ( Fact_TimeInTransit[OnTimePackages] )"
            ],
            "displayFolder": "2 Reliability",
            "formatString": "#,0"
          },
          {
            "name": "On-Time Delivery %",
            "expression": [
              "DIVIDE ( [On-Time Packages], [Packages Measured] )"
            ],
            "displayFolder": "2 Reliability",
            "formatString": "0.00%"
          },
          {
            "name": "Late Delivery %",
            "expression": [
              "DIVIDE ( [Total Late], [Packages Measured] )"
            ],
            "displayFolder": "2 Reliability",
            "formatString": "0.0%"
          },
          {
            "name": "Late by Day %",
            "expression": [
              "DIVIDE ( [Late by Day], [Packages Measured] )"
            ],
            "displayFolder": "2 Reliability",
            "formatString": "0.0%"
          },
          {
            "name": "Late by Time %",
            "expression": [
              "DIVIDE ( [Late by Time], [Packages Measured] )"
            ],
            "displayFolder": "2 Reliability",
            "formatString": "0.0%"
          },
          {
            "name": "Severity Mix (Day Share of Late)",
            "expression": [
              "DIVIDE ( [Late by Day], [Total Late] )"
            ],
            "displayFolder": "2 Reliability\\Trend and stability",
            "formatString": "0.0%"
          },
          {
            "name": "OTD % PM",
            "expression": [
              "VAR CurrentKey = SELECTEDVALUE ( Dim_Date[MonthKey] )",
              "VAR PriorKey =",
              "    IF ( MOD ( CurrentKey, 100 ) = 1, CurrentKey - 89, CurrentKey - 1 )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( CurrentKey ),",
              "        CALCULATE (",
              "            [On-Time Delivery %],",
              "            REMOVEFILTERS ( Dim_Date ),",
              "            Dim_Date[MonthKey] = PriorKey",
              "        )",
              "    )"
            ],
            "displayFolder": "2 Reliability\\Trend and stability",
            "formatString": "0.00%"
          },
          {
            "name": "OTD % Delta MoM",
            "expression": [
              "VAR Current = [On-Time Delivery %]",
              "VAR Prior = [OTD % PM]",
              "RETURN",
              "    IF ( NOT ISBLANK ( Current ) && NOT ISBLANK ( Prior ), Current - Prior )"
            ],
            "displayFolder": "2 Reliability\\Trend and stability",
            "formatString": "0.00%"
          },
          {
            "name": "OTD % Annual Benchmark",
            "expression": [
              "CALCULATE (",
              "    [On-Time Delivery %],",
              "    REMOVEFILTERS ( Dim_Date[MonthNumber], Dim_Date[MonthName], Dim_Date[Quarter],",
              "        Dim_Date[MonthYearLabel], Dim_Date[MonthKey] )",
              ")"
            ],
            "displayFolder": "2 Reliability\\Trend and stability",
            "formatString": "0.00%"
          },
          {
            "name": "OTD Volatility (pp)",
            "expression": [
              "VAR MonthlySeries =",
              "    ADDCOLUMNS (",
              "        CALCULATETABLE (",
              "            VALUES ( Dim_Date[MonthKey] ),",
              "            Dim_Date[IsReportable] = \"Yes\"",
              "        ),",
              "        \"@OTD\", [On-Time Delivery %]",
              "    )",
              "VAR Clean = FILTER ( MonthlySeries, NOT ISBLANK ( [@OTD] ) )",
              "RETURN",
              "    IF ( COUNTROWS ( Clean ) >= 2, STDEVX.P ( Clean, [@OTD] ) * 100 )"
            ],
            "displayFolder": "2 Reliability\\Trend and stability",
            "formatString": "#,0.00"
          },
          {
            "name": "Worst OTD Month",
            "expression": [
              "VAR MonthlySeries =",
              "    ADDCOLUMNS (",
              "        CALCULATETABLE (",
              "            VALUES ( Dim_Date[MonthYearLabel] ),",
              "            Dim_Date[IsReportable] = \"Yes\"",
              "        ),",
              "        \"@OTD\", [On-Time Delivery %]",
              "    )",
              "VAR Clean = FILTER ( MonthlySeries, NOT ISBLANK ( [@OTD] ) )",
              "RETURN",
              "    IF (",
              "        NOT ISEMPTY ( Clean ),",
              "        CONCATENATEX (",
              "            TOPN ( 1, Clean, [@OTD], ASC ),",
              "            Dim_Date[MonthYearLabel] & \" (\" & FORMAT ( [@OTD], \"0.0%\" ) & \")\"",
              "        )",
              "    )"
            ],
            "displayFolder": "2 Reliability\\Statistical confidence"
          },
          {
            "name": "OTD Wilson Lower Bound",
            "expression": [
              "VAR N = [Packages Measured]",
              "VAR Successes = [On-Time Packages]",
              "VAR Z = 1.96                                  // 95% two-sided",
              "VAR P = DIVIDE ( Successes, N )",
              "VAR Denominator = 1 + DIVIDE ( Z * Z, N )",
              "VAR Centre = P + DIVIDE ( Z * Z, 2 * N )",
              "VAR Margin =",
              "    Z * SQRT ( DIVIDE ( P * ( 1 - P ), N ) + DIVIDE ( Z * Z, 4 * N * N ) )",
              "RETURN",
              "    IF ( N > 0, DIVIDE ( Centre - Margin, Denominator ) )"
            ],
            "displayFolder": "2 Reliability\\Statistical confidence",
            "formatString": "0.00%"
          },
          {
            "name": "OTD Confidence Gap (pp)",
            "expression": [
              "VAR Gap = [On-Time Delivery %] - [OTD Wilson Lower Bound]",
              "RETURN",
              "    IF ( NOT ISBLANK ( Gap ), Gap * 100 )"
            ],
            "displayFolder": "2 Reliability\\Statistical confidence",
            "formatString": "#,0.00"
          },
          {
            "name": "OTD Confidence Label",
            "expression": [
              "VAR Gap = [OTD Confidence Gap (pp)]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( Gap ), \"No transit data\",",
              "        Gap <= 0.5, \"High confidence\",",
              "        Gap <= 2.0, \"Moderate confidence\",",
              "        Gap <= 10.0, \"Low confidence - small sample\",",
              "        \"Not interpretable - sample too small\"",
              "    )"
            ],
            "displayFolder": "2 Reliability\\Coverage"
          },
          {
            "name": "Months with Transit Data",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( Fact_TimeInTransit[MonthKey] ),",
              "    REMOVEFILTERS ( Dim_Service, Dim_Account )",
              ")"
            ],
            "displayFolder": "2 Reliability\\Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Transit Coverage %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( DISTINCTCOUNT ( Fact_TimeInTransit[MonthKey] ) ),",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( Fact_VolumeSpend[MonthKey] ),",
              "        REMOVEFILTERS ( Dim_Service )",
              "    )",
              ")"
            ],
            "displayFolder": "2 Reliability\\Coverage",
            "formatString": "0.0%"
          },
          {
            "name": "Has Transit Data",
            "expression": [
              "IF ( [Packages Measured] > 0, \"Yes\", \"No\" )"
            ],
            "displayFolder": "2 Reliability\\Coverage"
          },
          {
            "name": "Issued Claims Pkgs",
            "expression": [
              "SUM ( Fact_Claims[IssuedClaimsPkgQty] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "#,0"
          },
          {
            "name": "Paid Claims Pkgs",
            "expression": [
              "SUM ( Fact_Claims[PaidClaimsPkgQty] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "#,0"
          },
          {
            "name": "Registered Claims Pkgs",
            "expression": [
              "SUM ( Fact_Claims[RegisteredClaimsPkgQty] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "#,0"
          },
          {
            "name": "Paid Claims Amount",
            "expression": [
              "SUM ( Fact_Claims[PaidClaimsAmount] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "\\$#,0"
          },
          {
            "name": "Claims Declared Value",
            "expression": [
              "SUM ( Fact_Claims[ClaimsDeclaredValue] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "\\$#,0"
          },
          {
            "name": "Loss Claims",
            "expression": [
              "CALCULATE (",
              "    [Issued Claims Pkgs],",
              "    KEEPFILTERS ( Fact_Claims[ClaimsCategory] = \"Loss\" )",
              ")"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "#,0"
          },
          {
            "name": "Damage Claims",
            "expression": [
              "CALCULATE (",
              "    [Issued Claims Pkgs],",
              "    KEEPFILTERS ( Fact_Claims[ClaimsCategory] = \"Damage\" )",
              ")"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "#,0"
          },
          {
            "name": "Loss Claims Paid Amount",
            "expression": [
              "CALCULATE (",
              "    [Paid Claims Amount],",
              "    KEEPFILTERS ( Fact_Claims[ClaimsCategory] = \"Loss\" )",
              ")"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "\\$#,0"
          },
          {
            "name": "Claims Recovery Rate",
            "expression": [
              "DIVIDE ( [Paid Claims Pkgs], [Issued Claims Pkgs] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Paid per Claim",
            "expression": [
              "DIVIDE ( [Paid Claims Amount], [Paid Claims Pkgs] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "\\$#,0.00"
          },
          {
            "name": "Loss Claim Rate per 10k",
            "expression": [
              "DIVIDE ( [Loss Claims], [Rankable Shipments] ) * 10000"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "#,0.00"
          },
          {
            "name": "Claims Rate per 10k",
            "expression": [
              "DIVIDE ( [Issued Claims Pkgs], [Rankable Shipments] ) * 10000"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "#,0.00"
          },
          {
            "name": "Loss Claim Rate",
            "expression": [
              "DIVIDE ( [Loss Claims], [Rankable Shipments] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "0.00%"
          },
          {
            "name": "Exception / Claims Rate",
            "expression": [
              "DIVIDE ( [Issued Claims Pkgs], [Rankable Shipments] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier B: supported claim measures (account grain)",
            "formatString": "0.00%"
          },
          {
            "name": "Claims Cost per 1k Shipments",
            "expression": [
              "DIVIDE ( [Paid Claims Amount], [Rankable Shipments] ) * 1000"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Concentration",
            "formatString": "\\$#,0.00"
          },
          {
            "name": "Firm-wide Loss Rate per 10k",
            "expression": [
              "CALCULATE (",
              "    [Loss Claim Rate per 10k],",
              "    REMOVEFILTERS ( Dim_Account, Dim_Service )",
              ")"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Concentration",
            "formatString": "#,0.00"
          },
          {
            "name": "Loss Rate Index vs Firm",
            "expression": [
              "DIVIDE ( [Loss Claim Rate per 10k], [Firm-wide Loss Rate per 10k] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Concentration",
            "formatString": "#,0.00"
          },
          {
            "name": "Loss Risk Flag",
            "expression": [
              "VAR Idx = [Loss Rate Index vs Firm]",
              "VAR Vol = [Rankable Shipments]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( [Loss Claims] ) || [Loss Claims] = 0, \"No loss activity\",",
              "        Vol < 500, \"Insufficient volume to rate\",",
              "        Idx >= 3, \"Critical - investigate\",",
              "        Idx >= 2, \"Elevated - monitor\",",
              "        Idx >= 1, \"Above firm average\",",
              "        \"At or below firm average\"",
              "    )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Concentration"
          },
          {
            "name": "Top Account Share of Loss Claims",
            "expression": [
              "VAR ByAccount =",
              "    ADDCOLUMNS (",
              "        CALCULATETABLE ( VALUES ( Dim_Account[AccountKey] ), REMOVEFILTERS ( Dim_Account ) ),",
              "        \"@Loss\", [Loss Claims]",
              "    )",
              "VAR TotalLoss = SUMX ( ByAccount, [@Loss] )",
              "VAR TopLoss = MAXX ( ByAccount, [@Loss] )",
              "RETURN",
              "    DIVIDE ( TopLoss, TotalLoss )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Concentration",
            "formatString": "0.0%"
          },
          {
            "name": "Top Account by Loss Claims",
            "expression": [
              "VAR ByAccount =",
              "    ADDCOLUMNS (",
              "        CALCULATETABLE ( VALUES ( Dim_Account[AccountName] ), REMOVEFILTERS ( Dim_Account ) ),",
              "        \"@Loss\", [Loss Claims]",
              "    )",
              "RETURN",
              "    CONCATENATEX ( TOPN ( 1, ByAccount, [@Loss], DESC ), Dim_Account[AccountName] )"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier C: allocated service proxy - handle with care"
          },
          {
            "name": "Loss Claims (Allocated Proxy)",
            "expression": [
              "SUMX (",
              "    VALUES ( Dim_Account[AccountKey] ),",
              "    VAR AccountLoss = CALCULATE ( [Loss Claims], REMOVEFILTERS ( Dim_Service ) )",
              "    VAR AccountVolumeAllServices =",
              "        CALCULATE ( [Rankable Shipments], REMOVEFILTERS ( Dim_Service ) )",
              "    VAR VolumeInScope = [Rankable Shipments]",
              "    RETURN",
              "        AccountLoss * DIVIDE ( VolumeInScope, AccountVolumeAllServices )",
              ")"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier C: allocated service proxy - handle with care",
            "formatString": "#,0.0"
          },
          {
            "name": "Loss Claim Rate per 10k (Allocated Proxy)",
            "expression": [
              "DIVIDE ( [Loss Claims (Allocated Proxy)], [Rankable Shipments] ) * 10000"
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier C: allocated service proxy - handle with care",
            "formatString": "#,0.00"
          },
          {
            "name": "Claims Attribution Warning",
            "expression": [
              "\"Allocated estimate. The claims extract carries no service or tracking key; \"",
              "    & \"account-level claims are distributed across services by shipment volume. \"",
              "    & \"Not a measured service-level loss rate. Do not use for service selection.\""
            ],
            "displayFolder": "3 Claims and Loss Risk\\Tier C: allocated service proxy - handle with care"
          },
          {
            "name": "Minimum Shipment Threshold",
            "expression": [
              "SELECTEDVALUE ( 'Volume Threshold'[Volume Threshold], 1000 )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\1. Qualification",
            "formatString": "#,0"
          },
          {
            "name": "Minimum Volume Share",
            "expression": [
              "SELECTEDVALUE ( 'Share Threshold'[Share Threshold], 0.01 )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\1. Qualification",
            "formatString": "0.0%"
          },
          {
            "name": "Minimum Measured Packages",
            "expression": [
              "384"
            ],
            "displayFolder": "4 Scoring and Recommendation\\1. Qualification",
            "formatString": "#,0"
          },
          {
            "name": "Service Volume Share",
            "expression": [
              "DIVIDE (",
              "    [Rankable Shipments],",
              "    CALCULATE ( [Rankable Shipments], REMOVEFILTERS ( Dim_Service ) )",
              ")"
            ],
            "displayFolder": "4 Scoring and Recommendation\\1. Qualification",
            "formatString": "0.0%"
          },
          {
            "name": "Annual Qualification Flag",
            "expression": [
              "VAR MeetsAbsolute = [Rankable Shipments] >= [Minimum Shipment Threshold]",
              "VAR MeetsShare = [Service Volume Share] >= [Minimum Volume Share]",
              "VAR MeetsMeasurement = [Packages Measured] >= [Minimum Measured Packages]",
              "",
              "",
              "",
              "VAR IsRankableService = SELECTEDVALUE ( Dim_Service[IncludeInRanking] ) = \"Yes\"",
              "RETURN",
              "    IF ( MeetsAbsolute && MeetsShare && MeetsMeasurement && IsRankableService, 1, 0 )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\1. Qualification",
            "formatString": "#,0"
          },
          {
            "name": "Qualification Status",
            "expression": [
              "VAR Vol = [Rankable Shipments]",
              "VAR Measured = [Packages Measured]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        [Annual Qualification Flag] = 1, \"Qualified\",",
              "        ISBLANK ( Vol ) || Vol = 0, \"No shipment volume\",",
              "        Measured < [Minimum Measured Packages],",
              "            \"Transit sample too small (\" & FORMAT ( Measured, \"#,0\" ) & \" measured, \"",
              "                & FORMAT ( [Minimum Measured Packages], \"#,0\" ) & \" required)\",",
              "        Vol < [Minimum Shipment Threshold],",
              "            \"Below volume floor (\" & FORMAT ( Vol, \"#,0\" ) & \" of \"",
              "                & FORMAT ( [Minimum Shipment Threshold], \"#,0\" ) & \")\",",
              "        [Service Volume Share] < [Minimum Volume Share],",
              "            \"Below \" & FORMAT ( [Minimum Volume Share], \"0.0%\" ) & \" volume share\",",
              "        \"Excluded from ranking by service mapping\"",
              "    )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\1. Qualification"
          },
          {
            "name": "Qualified Service Count",
            "expression": [
              "COUNTROWS (",
              "    FILTER (",
              "        CALCULATETABLE (",
              "            VALUES ( Dim_Service[ServiceGroup] ),",
              "            REMOVEFILTERS ( Dim_Service )",
              "        ),",
              "        [Annual Qualification Flag] = 1",
              "    )",
              ")"
            ],
            "displayFolder": "4 Scoring and Recommendation\\2. Normalised component scores",
            "formatString": "#,0"
          },
          {
            "name": "Score - Reliability",
            "expression": [
              "VAR QualifiedSet =",
              "    FILTER (",
              "        CALCULATETABLE (",
              "            VALUES ( Dim_Service[ServiceGroup] ),",
              "            REMOVEFILTERS ( Dim_Service )",
              "        ),",
              "        [Annual Qualification Flag] = 1",
              "    )",
              "VAR WithMetric = ADDCOLUMNS ( QualifiedSet, \"@M\", [OTD Wilson Lower Bound] )",
              "VAR Populated = FILTER ( WithMetric, NOT ISBLANK ( [@M] ) )",
              "VAR MinV = MINX ( Populated, [@M] )",
              "VAR MaxV = MAXX ( Populated, [@M] )",
              "VAR Self = [OTD Wilson Lower Bound]",
              "RETURN",
              "    IF (",
              "        [Annual Qualification Flag] = 1 && NOT ISBLANK ( Self ),",
              "        IF ( MaxV = MinV, 1, DIVIDE ( Self - MinV, MaxV - MinV ) )",
              "    )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\2. Normalised component scores",
            "formatString": "#,0.00"
          },
          {
            "name": "Score - Loss Risk",
            "expression": [
              "VAR QualifiedSet =",
              "    FILTER (",
              "        CALCULATETABLE (",
              "            VALUES ( Dim_Service[ServiceGroup] ),",
              "            REMOVEFILTERS ( Dim_Service )",
              "        ),",
              "        [Annual Qualification Flag] = 1",
              "    )",
              "VAR WithMetric = ADDCOLUMNS ( QualifiedSet, \"@M\", [Loss Claim Rate per 10k] )",
              "VAR Populated = FILTER ( WithMetric, NOT ISBLANK ( [@M] ) )",
              "VAR MinV = MINX ( Populated, [@M] )",
              "VAR MaxV = MAXX ( Populated, [@M] )",
              "VAR Self = [Loss Claim Rate per 10k]",
              "RETURN",
              "    IF (",
              "        [Annual Qualification Flag] = 1 && NOT ISBLANK ( Self ) && [Claims Service Key Available] = 1,",
              "        IF ( MaxV = MinV, 1, 1 - DIVIDE ( Self - MinV, MaxV - MinV ) )",
              "    )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\2. Normalised component scores",
            "formatString": "#,0.00"
          },
          {
            "name": "Score - Exception Risk",
            "expression": [
              "VAR QualifiedSet =",
              "    FILTER (",
              "        CALCULATETABLE (",
              "            VALUES ( Dim_Service[ServiceGroup] ),",
              "            REMOVEFILTERS ( Dim_Service )",
              "        ),",
              "        [Annual Qualification Flag] = 1",
              "    )",
              "VAR WithMetric = ADDCOLUMNS ( QualifiedSet, \"@M\", [Claims Rate per 10k] )",
              "VAR Populated = FILTER ( WithMetric, NOT ISBLANK ( [@M] ) )",
              "VAR MinV = MINX ( Populated, [@M] )",
              "VAR MaxV = MAXX ( Populated, [@M] )",
              "VAR Self = [Claims Rate per 10k]",
              "RETURN",
              "    IF (",
              "        [Annual Qualification Flag] = 1 && NOT ISBLANK ( Self ) && [Claims Service Key Available] = 1,",
              "        IF ( MaxV = MinV, 1, 1 - DIVIDE ( Self - MinV, MaxV - MinV ) )",
              "    )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\2. Normalised component scores",
            "formatString": "#,0.00"
          },
          {
            "name": "Score - Cost",
            "expression": [
              "VAR QualifiedSet =",
              "    FILTER (",
              "        CALCULATETABLE (",
              "            VALUES ( Dim_Service[ServiceGroup] ),",
              "            REMOVEFILTERS ( Dim_Service )",
              "        ),",
              "        [Annual Qualification Flag] = 1",
              "    )",
              "VAR WithMetric = ADDCOLUMNS ( QualifiedSet, \"@M\", [Avg Net Spend per Billed Lb] )",
              "VAR Populated = FILTER ( WithMetric, NOT ISBLANK ( [@M] ) )",
              "VAR MinV = MINX ( Populated, [@M] )",
              "VAR MaxV = MAXX ( Populated, [@M] )",
              "VAR Self = [Avg Net Spend per Billed Lb]",
              "RETURN",
              "    IF (",
              "        [Annual Qualification Flag] = 1 && NOT ISBLANK ( Self ),",
              "        IF ( MaxV = MinV, 1, 1 - DIVIDE ( Self - MinV, MaxV - MinV ) )",
              "    )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\3. Weighted blend with reallocation",
            "formatString": "#,0.00"
          },
          {
            "name": "Weight - Reliability",
            "expression": [
              "0.40"
            ],
            "displayFolder": "4 Scoring and Recommendation\\3. Weighted blend with reallocation",
            "formatString": "0%"
          },
          {
            "name": "Weight - Loss Risk",
            "expression": [
              "0.30"
            ],
            "displayFolder": "4 Scoring and Recommendation\\3. Weighted blend with reallocation",
            "formatString": "0%"
          },
          {
            "name": "Weight - Exception Risk",
            "expression": [
              "0.20"
            ],
            "displayFolder": "4 Scoring and Recommendation\\3. Weighted blend with reallocation",
            "formatString": "0%"
          },
          {
            "name": "Weight - Cost",
            "expression": [
              "0.10"
            ],
            "displayFolder": "4 Scoring and Recommendation\\3. Weighted blend with reallocation",
            "formatString": "0%"
          },
          {
            "name": "Claims Service Key Available",
            "expression": [
              "0"
            ],
            "displayFolder": "4 Scoring and Recommendation\\3. Weighted blend with reallocation",
            "formatString": "#,0"
          },
          {
            "name": "Effective Weight Total",
            "expression": [
              "VAR W =",
              "    IF ( NOT ISBLANK ( [Score - Reliability] ), [Weight - Reliability], 0 )",
              "        + IF ( NOT ISBLANK ( [Score - Loss Risk] ), [Weight - Loss Risk], 0 )",
              "        + IF ( NOT ISBLANK ( [Score - Exception Risk] ), [Weight - Exception Risk], 0 )",
              "        + IF ( NOT ISBLANK ( [Score - Cost] ), [Weight - Cost], 0 )",
              "RETURN",
              "    IF ( W > 0, W )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\3. Weighted blend with reallocation",
            "formatString": "#,0.00"
          },
          {
            "name": "Service Consistency Score",
            "expression": [
              "VAR Weighted =",
              "    IF ( NOT ISBLANK ( [Score - Reliability] ), [Score - Reliability] * [Weight - Reliability], 0 )",
              "        + IF ( NOT ISBLANK ( [Score - Loss Risk] ), [Score - Loss Risk] * [Weight - Loss Risk], 0 )",
              "        + IF ( NOT ISBLANK ( [Score - Exception Risk] ), [Score - Exception Risk] * [Weight - Exception Risk], 0 )",
              "        + IF ( NOT ISBLANK ( [Score - Cost] ), [Score - Cost] * [Weight - Cost], 0 )",
              "RETURN",
              "    IF (",
              "        [Annual Qualification Flag] = 1,",
              "        DIVIDE ( Weighted, [Effective Weight Total] ) * 100",
              "    )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\3. Weighted blend with reallocation",
            "formatString": "#,0.0"
          },
          {
            "name": "Score Basis",
            "expression": [
              "VAR Covered =",
              "    IF ( NOT ISBLANK ( [Score - Reliability] ), \"Reliability \" & FORMAT ( [Weight - Reliability] / [Effective Weight Total], \"0%\" ) & \"; \", \"\" )",
              "        & IF ( NOT ISBLANK ( [Score - Loss Risk] ), \"Loss risk \" & FORMAT ( [Weight - Loss Risk] / [Effective Weight Total], \"0%\" ) & \"; \", \"\" )",
              "        & IF ( NOT ISBLANK ( [Score - Exception Risk] ), \"Exceptions \" & FORMAT ( [Weight - Exception Risk] / [Effective Weight Total], \"0%\" ) & \"; \", \"\" )",
              "        & IF ( NOT ISBLANK ( [Score - Cost] ), \"Cost \" & FORMAT ( [Weight - Cost] / [Effective Weight Total], \"0%\" ), \"\" )",
              "VAR Missing =",
              "    IF ( ISBLANK ( [Score - Loss Risk] ) || ISBLANK ( [Score - Exception Risk] ),",
              "        \" | Claims components unavailable at service grain - weights reallocated.\", \"\" )",
              "RETURN",
              "    \"Effective weights: \" & Covered & Missing"
            ],
            "displayFolder": "4 Scoring and Recommendation\\3. Weighted blend with reallocation"
          },
          {
            "name": "Service Rank",
            "expression": [
              "IF (",
              "    [Annual Qualification Flag] = 1,",
              "    RANKX (",
              "        FILTER (",
              "            CALCULATETABLE (",
              "                VALUES ( Dim_Service[ServiceGroup] ),",
              "                REMOVEFILTERS ( Dim_Service )",
              "            ),",
              "            [Annual Qualification Flag] = 1",
              "        ),",
              "        [Service Consistency Score],",
              "        ,",
              "        DESC,",
              "        DENSE",
              "    )",
              ")"
            ],
            "displayFolder": "4 Scoring and Recommendation\\4. Recommendation categories",
            "formatString": "#,0"
          },
          {
            "name": "Recommendation Category",
            "expression": [
              "VAR Qualified = [Annual Qualification Flag] = 1",
              "VAR QualCount = [Qualified Service Count]",
              "VAR Tier = SELECTEDVALUE ( Dim_Service[ServiceTier] )",
              "VAR Rank = [Service Rank]",
              "VAR BestPremiumRank =",
              "    RANKX (",
              "        FILTER (",
              "            CALCULATETABLE (",
              "                VALUES ( Dim_Service[ServiceGroup] ),",
              "                REMOVEFILTERS ( Dim_Service )",
              "            ),",
              "            [Annual Qualification Flag] = 1",
              "                && SELECTEDVALUE ( Dim_Service[ServiceTier] ) = \"Premium\"",
              "        ),",
              "        [OTD Wilson Lower Bound],",
              "        ,",
              "        DESC,",
              "        DENSE",
              "    )",
              "VAR IsVolumeAnchor = [Service Volume Share] >= 0.50",
              "VAR Volatile = [OTD Volatility (pp)] > 1.5",
              "VAR BelowFirmOTD = [On-Time Delivery %] < CALCULATE ( [On-Time Delivery %], REMOVEFILTERS ( Dim_Service ) )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        NOT Qualified, \"Not ranked - \" & [Qualification Status],",
              "        QualCount <= 1, \"Single qualified service - no comparison possible\",",
              "        // The service the firm actually runs on. It is the default by",
              "        // economics; the question the dashboard answers is whether its",
              "        // reliability is acceptable, not whether to replace it.",
              "        IsVolumeAnchor && BelowFirmOTD, \"Volume anchor - reliability below firm average, monitor\",",
              "        IsVolumeAnchor, \"Recommended default service\",",
              "        Rank = 1 && Tier <> \"Premium\", \"Recommended default service\",",
              "        Rank = 1, \"Best overall performer\",",
              "        BestPremiumRank = 1, \"Recommended premium service\",",
              "        Volatile, \"Service to monitor - inconsistent month to month\",",
              "        \"Qualified alternative\"",
              "    )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\4. Recommendation categories"
          },
          {
            "name": "Recommendation Callout",
            "expression": [
              "VAR MonthsCovered = [Months with Transit Data]",
              "VAR BestService =",
              "    CONCATENATEX (",
              "        TOPN (",
              "            1,",
              "            FILTER (",
              "                CALCULATETABLE (",
              "                    VALUES ( Dim_Service[ServiceGroup] ),",
              "                    REMOVEFILTERS ( Dim_Service )",
              "                ),",
              "                [Annual Qualification Flag] = 1",
              "            ),",
              "            [Service Consistency Score],",
              "            DESC",
              "        ),",
              "        Dim_Service[ServiceGroup]",
              "    )",
              "VAR FirmOTD = CALCULATE ( [On-Time Delivery %], REMOVEFILTERS ( Dim_Service ) )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        MonthsCovered = 0,",
              "            \"No Time-in-Transit data loaded. Reliability cannot be assessed and no service recommendation can be made.\",",
              "        MonthsCovered < 6,",
              "            \"PROVISIONAL - based on \" & MonthsCovered & \" month(s) of Time-in-Transit data. \"",
              "                & \"Highest-scoring qualified service: \" & BestService & \". \"",
              "                & \"Firm-wide on-time delivery \" & FORMAT ( FirmOTD, \"0.0%\" ) & \". \"",
              "                & \"Do not issue as an annual service policy until at least six completed months are loaded.\",",
              "        \"Highest-scoring qualified service: \" & BestService & \". Firm-wide on-time delivery \"",
              "            & FORMAT ( FirmOTD, \"0.0%\" ) & \" across \" & MonthsCovered & \" months.\"",
              "    )"
            ],
            "displayFolder": "4 Scoring and Recommendation\\4. Recommendation categories"
          },
          {
            "name": "Months Loaded",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( Dim_Date[MonthKey] ),",
              "    Dim_Date[IsLoaded] = \"Yes\",",
              "    REMOVEFILTERS ( Dim_Date )",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Completed Months Loaded",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( Dim_Date[MonthKey] ),",
              "    Dim_Date[IsReportable] = \"Yes\",",
              "    REMOVEFILTERS ( Dim_Date )",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Missing Months",
            "expression": [
              "VAR Expected =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( Dim_Date[MonthKey] ),",
              "        Dim_Date[IsCompletedMonth] = \"Yes\",",
              "        REMOVEFILTERS ( Dim_Date )",
              "    )",
              "RETURN",
              "    Expected - [Completed Months Loaded]"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Missing Months List",
            "expression": [
              "CONCATENATEX (",
              "    CALCULATETABLE (",
              "        VALUES ( Dim_Date[MonthYearLabel] ),",
              "        Dim_Date[IsCompletedMonth] = \"Yes\",",
              "        Dim_Date[IsLoaded] = \"No\",",
              "        REMOVEFILTERS ( Dim_Date )",
              "    ),",
              "    Dim_Date[MonthYearLabel],",
              "    \", \",",
              "    Dim_Date[SortOrder],",
              "    ASC",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Coverage"
          },
          {
            "name": "Annual Completeness %",
            "expression": [
              "DIVIDE ( [Months Loaded], 12 )"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Coverage",
            "formatString": "0.0%"
          },
          {
            "name": "Volume Months Covered",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( Fact_VolumeSpend[MonthKey] ), REMOVEFILTERS ( Dim_Date ) )"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Transit Months Covered",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( Fact_TimeInTransit[MonthKey] ), REMOVEFILTERS ( Dim_Date ) )"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Claims Months Covered",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( Fact_Claims[MonthKey] ), REMOVEFILTERS ( Dim_Date ) )"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Coverage Summary",
            "expression": [
              "\"Volume & Spend: \" & [Volume Months Covered] & \" mo  |  \"",
              "    & \"Time-in-Transit: \" & [Transit Months Covered] & \" mo  |  \"",
              "    & \"Claims: \" & [Claims Months Covered] & \" mo\""
            ],
            "displayFolder": "5 Data Quality and Narrative\\Exclusions"
          },
          {
            "name": "Excluded Adjustment Spend",
            "expression": [
              "CALCULATE (",
              "    SUM ( Fact_VolumeSpend[NetSpend] ),",
              "    KEEPFILTERS ( Fact_VolumeSpend[IncludeInRanking] = \"No\" )",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Exclusions",
            "formatString": "\\$#,0"
          },
          {
            "name": "Excluded Adjustment Spend %",
            "expression": [
              "DIVIDE (",
              "    [Excluded Adjustment Spend],",
              "    CALCULATE ( SUM ( Fact_VolumeSpend[NetSpend] ), REMOVEFILTERS ( Dim_Service ) )",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Exclusions",
            "formatString": "0.0%"
          },
          {
            "name": "Spend-Only Adjustment Rows",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( Fact_VolumeSpend ),",
              "    KEEPFILTERS ( Fact_VolumeSpend[IsSpendOnlyAdjustment] = \"Yes\" )",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Exclusions",
            "formatString": "#,0"
          },
          {
            "name": "Spend-Only Adjustment Value",
            "expression": [
              "CALCULATE (",
              "    SUM ( Fact_VolumeSpend[NetSpend] ),",
              "    KEEPFILTERS ( Fact_VolumeSpend[IsSpendOnlyAdjustment] = \"Yes\" )",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Exclusions",
            "formatString": "\\$#,0"
          },
          {
            "name": "Unattributed Spend %",
            "expression": [
              "DIVIDE (",
              "    [Spend-Only Adjustment Value],",
              "    CALCULATE ( SUM ( Fact_VolumeSpend[NetSpend] ), REMOVEFILTERS ( Dim_Service ) )",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Exclusions",
            "formatString": "0.0%"
          },
          {
            "name": "Unmapped Product Rows",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( Fact_VolumeSpend ),",
              "    KEEPFILTERS ( Fact_VolumeSpend[ServiceGroup] = \"Unmapped - Review\" )",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Exclusions",
            "formatString": "#,0"
          },
          {
            "name": "Masked Sub-Parent Volume",
            "expression": [
              "CALCULATE (",
              "    [Total Shipments],",
              "    KEEPFILTERS ( Fact_VolumeSpend[IsMaskedSubParent] = \"Yes\" )",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Reconciliation",
            "formatString": "#,0"
          },
          {
            "name": "Accessorial Net Spend",
            "expression": [
              "SUM ( Fact_Accessorial[NetSpend] )"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Reconciliation",
            "formatString": "\\$#,0"
          },
          {
            "name": "Spend Reconciliation Variance",
            "expression": [
              "VAR VolumeSpendTotal =",
              "    CALCULATE ( SUM ( Fact_VolumeSpend[NetSpend] ), REMOVEFILTERS ( Dim_Service ) )",
              "VAR AccessorialTotal =",
              "    CALCULATE ( [Accessorial Net Spend], REMOVEFILTERS ( Dim_Service ) )",
              "RETURN",
              "    IF ( AccessorialTotal <> 0, VolumeSpendTotal - AccessorialTotal )"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Reconciliation",
            "formatString": "\\$#,0.00"
          },
          {
            "name": "Reconciliation Status",
            "expression": [
              "VAR Variance = [Spend Reconciliation Variance]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( Variance ), \"No accessorial detail for this period\",",
              "        ABS ( Variance ) < 1, \"Reconciled\",",
              "        ABS ( Variance ) < 100, \"Rounding variance - \" & FORMAT ( Variance, \"$#,0.00\" ),",
              "        \"VARIANCE - \" & FORMAT ( Variance, \"$#,0.00\" ) & \" - investigate before publishing\"",
              "    )"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Reconciliation"
          },
          {
            "name": "Measured vs Billed Coverage %",
            "expression": [
              "DIVIDE ( [Packages Measured], [Rankable Shipments] )"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Banner narrative",
            "formatString": "0.0%"
          },
          {
            "name": "Data Basis Banner",
            "expression": [
              "VAR VolMonths = [Volume Months Covered]",
              "VAR TransitMonths = [Transit Months Covered]",
              "VAR ClaimsMonths = [Claims Months Covered]",
              "VAR Missing = [Missing Months List]",
              "VAR Recon = [Reconciliation Status]",
              "VAR Severity =",
              "    SWITCH (",
              "        TRUE (),",
              "        TransitMonths = 0, \"NO RELIABILITY DATA\",",
              "        TransitMonths < 6 || ClaimsMonths < 6, \"PROVISIONAL\",",
              "        VolMonths < 12, \"PARTIAL YEAR\",",
              "        \"ANNUAL\"",
              "    )",
              "RETURN",
              "    Severity & \" - \" & [Coverage Summary]",
              "        & IF ( LEN ( Missing ) > 0, \"  |  Not yet loaded: \" & Missing, \"\" )",
              "        & IF ( Recon <> \"Reconciled\" && LEFT ( Recon, 2 ) = \"VA\", \"  |  \" & Recon, \"\" )"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Banner narrative"
          },
          {
            "name": "Data Basis Banner Colour",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    [Transit Months Covered] = 0, \"#B3261E\",",
              "    [Transit Months Covered] < 6 || [Claims Months Covered] < 6, \"#B26B00\",",
              "    [Volume Months Covered] < 12, \"#5B4B8A\",",
              "    \"#1F6F54\"",
              ")"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Dynamic titles"
          },
          {
            "name": "Title - Executive Overview",
            "expression": [
              "VAR Period =",
              "    IF (",
              "        ISFILTERED ( Dim_Date[MonthYearLabel] ) || ISFILTERED ( Dim_Date[Quarter] ),",
              "        CONCATENATEX (",
              "            VALUES ( Dim_Date[MonthYearLabel] ),",
              "            Dim_Date[MonthYearLabel], \", \", Dim_Date[SortOrder], ASC",
              "        ),",
              "        SELECTEDVALUE ( Dim_Date[Year], \"2025\" ) & \" full year\"",
              "    )",
              "VAR Scope =",
              "    IF (",
              "        ISFILTERED ( Dim_Service[Scope] ),",
              "        SELECTEDVALUE ( Dim_Service[Scope], \"All scopes\" ),",
              "        \"Domestic and international\"",
              "    )",
              "RETURN",
              "    \"UPS Shipping Performance - \" & Period & \" - \" & Scope"
            ],
            "displayFolder": "5 Data Quality and Narrative\\Dynamic titles"
          },
          {
            "name": "Title - Service Scorecard",
            "expression": [
              "\"Service scorecard - \" & [Qualified Service Count] & \" of \"",
              "    & CALCULATE (",
              "        DISTINCTCOUNT ( Dim_Service[ServiceGroup] ),",
              "        REMOVEFILTERS ( Dim_Service ),",
              "        Dim_Service[IncludeInRanking] = \"Yes\"",
              "    )",
              "    & \" services qualify at \"",
              "    & FORMAT ( [Minimum Shipment Threshold], \"#,0\" ) & \" shipments / \"",
              "    & FORMAT ( [Minimum Volume Share], \"0.0%\" ) & \" share\""
            ],
            "displayFolder": "5 Data Quality and Narrative\\Dynamic titles"
          },
          {
            "name": "Title - Claims",
            "expression": [
              "\"Claims and loss risk - account level only (\"",
              "    & [Claims Months Covered] & \" month(s) loaded). \"",
              "    & \"Claims carry no service key.\""
            ],
            "displayFolder": "5 Data Quality and Narrative\\Dynamic titles"
          }
        ]
      }
    ],
    "relationships": [
