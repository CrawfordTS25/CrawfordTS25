            "formatString": "#,0",
            "summarizeBy": "none",
            "type": "calculatedTableColumn",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
