              "expression": "GENERATESERIES(0, 10000, 250)"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "95d8e0ca2f434042954fec9db6564a4b"
          }
        ]
      },
      {
        "name": "Share Threshold",
        "columns": [
          {
            "name": "Share Threshold",
            "dataType": "double",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value]",
            "formatString": "0.0%",
